<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Glint</AssemblyName>
    <RootNamespace>Glint</RootNamespace>
    <StartupObject>Glint.Program</StartupObject>
    <Version>0.1.0</Version>
    <Product>Glint</Product>
    <Description>Spotlight-style whole-disk file search for Windows.</Description>
  </PropertyGroup>
</Project>
